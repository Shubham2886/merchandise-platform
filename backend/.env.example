# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/merch_platform

# JWT
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Payments (mock gateway - Razorpay-style contract, no real keys needed)
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Shipping (mock provider - Shiprocket-style contract)
SHIPPING_MODE=mock
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
